# =====================================================================
# Tabernacle Ways: contoh pengaturan (.env)
# Salin file ini menjadi ".env" lalu isi nilainya. JANGAN commit file .env.
# Password dan kunci rahasia hanya boleh ada di .env, tidak di kode.
# =====================================================================

# --- Aplikasi ---------------------------------------------------------
APP_NAME="Tabernacle Ways"
# production di server, local di komputer sendiri
APP_ENV=production
# Diisi otomatis oleh: php artisan key:generate --force
APP_KEY=
# WAJIB false di server. true hanya untuk pengembangan lokal.
APP_DEBUG=false
# Alamat situs lengkap, tanpa garis miring di akhir
APP_URL=https://domain-anda.com

# Bahasa bawaan situs (id atau en). Pengunjung bisa mengganti sendiri.
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

# --- Log --------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Di server cukup "warning"
LOG_LEVEL=warning

# --- Database MySQL/MariaDB (dibuat di cPanel > MySQL Databases) -------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Di cPanel nama database dan user biasanya berawalan nama akun, contoh: exos7198_tabernacle
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sesi, cache, antrean ---------------------------------------------
SESSION_DRIVER=database
# Menit tanpa aktivitas sebelum admin otomatis keluar (session timeout)
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true bila situs memakai HTTPS (disarankan)
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
# Antrean memakai tabel database. Dijalankan oleh cron (lihat DEPLOY.md).
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Email (SATU-SATUNYA jalur: SMTP GoDaddy, bukan fungsi mail() PHP) --
# Dipakai untuk: notifikasi lead ke penerima, reset password admin, email uji.
MAIL_MAILER=smtp
MAIL_HOST=smtpout.secureserver.net
MAIL_PORT=465
# Port 465 memakai SSL penuh, jadi skemanya smtps
MAIL_SCHEME=smtps
# Alamat email GoDaddy lengkap Anda
MAIL_USERNAME=
# Password email GoDaddy. Isi hanya di server, jangan dibagikan.
MAIL_PASSWORD=
# Harus sama dengan MAIL_USERNAME agar tidak ditolak GoDaddy
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Lain-lain --------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
